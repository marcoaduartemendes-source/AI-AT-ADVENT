[Unit]
Description=AI-AT-ADVENT dashboard static HTTP server (port 8080)
After=network-online.target
Wants=network-online.target

[Service]
# Long-running HTTP server (NOT oneshot like dashboard.service which
# rebuilds the file). Serves /opt/ai-at-advent/docs over HTTP on 8080.
#
# 2026-05-30: REVERTED from port 80 back to 8080. The port-80 attempt
# broke the user's working browser access — 8080 was confirmed
# internet-reachable (external port check showed it open), port 80 was
# not. Restore the known-good port. Open the URL as http://<ip>:8080/
# (force http:// — browsers auto-upgrade bare IPs to https, which fails
# since there's no TLS).
#
# Why not nginx: this is a single static file with auto-reload — the
# stdlib http.server is enough and adds zero install footprint.
Type=simple
User=aaa
Group=aaa
WorkingDirectory=/opt/ai-at-advent
# Dashboard auth creds (DASHBOARD_USER / DASHBOARD_PASS) come from a
# DEDICATED file, NOT the big /etc/aaa.env. 2026-05-30: a reboot wiped
# the creds out of aaa.env and the service crash-looped for hours
# ("FATAL: DASHBOARD_USER ... must be set"). aaa.env is also fragile to
# source (multi-line KALSHI PEM). The dedicated /etc/aaa-dashboard.env
# is loaded directly by systemd (the leading `-` makes it optional so
# the unit never fails to load), so nothing else can break the
# dashboard's auth. We still source aaa.env for any other vars the
# build might reference, but the creds no longer depend on it.
EnvironmentFile=-/etc/aaa-dashboard.env
ExecStart=/usr/bin/env bash -c 'set -a; . /etc/aaa.env 2>/dev/null || true; set +a; exec /opt/ai-at-advent/.venv/bin/python src/dashboard_http.py'
# 2026-06-03: Restart=always (not on-failure) — survives any wedge or
# clean exit; systemd brings it back within seconds. A dashboard going
# down silently for a week is not acceptable.
Restart=always
RestartSec=3
StartLimitBurst=10
StartLimitIntervalSec=60

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/opt/ai-at-advent/docs

[Install]
WantedBy=multi-user.target
